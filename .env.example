# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="file:./dev.db"

# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Get this from https://resend.com after verifying a sending domain (or use
# their onboarding@resend.dev sender for testing without domain verification).
RESEND_API_KEY=
EMAIL_FROM="Kargo Hiring <hiring@kargo.example>"

# When true (default), emails are logged to the Audit Log / console instead
# of actually being sent via Resend. Flip to false only when you're ready for
# real sends.
DRY_RUN=true

# Shown in Advance emails as the scheduling link.
SCHEDULING_LINK="https://cal.com/kargo/interview"
