# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (e.g. Supabase or Neon). DATABASE_URL is the pooled connection
# used by the running app; DIRECT_URL is the direct connection used only for
# schema changes (prisma db push / migrate) — pgbouncer transaction-mode
# pooling doesn't support the session-level features those need. If your
# password contains reserved URI characters (@, :, /, etc.), percent-encode
# them (e.g. "@" -> "%40").
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Get this from https://resend.com after verifying a sending domain (or use
# their onboarding@resend.dev sender for testing without domain verification).
RESEND_API_KEY=
EMAIL_FROM="Kargo Hiring <hiring@kargo.example>"

# When true (default), emails are logged to the Audit Log / console instead
# of actually being sent via Resend. Flip to false only when you're ready for
# real sends.
DRY_RUN=true

# Optional. When set, every real send (DRY_RUN=false) is redirected to this
# address instead of the candidate's actual email — useful when testing real
# sends with Resend's unverified onboarding@resend.dev sender (which can only
# deliver to your own Resend signup address) or with placeholder test data.
TEST_EMAIL_OVERRIDE=

# Shown in Advance emails as the scheduling link.
SCHEDULING_LINK="https://cal.com/kargo/interview"
